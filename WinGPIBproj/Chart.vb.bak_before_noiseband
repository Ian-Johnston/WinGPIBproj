    ' Mean / STDEV / min / max / peak-to-peak / drift of one trace between two X positions (X is the sample index).
    Private Function Chart2RegionLine(name As String, data As List(Of ScottPlot.Coordinates), first As Integer, last As Integer) As String

        If last - first < 1 Then Return name & ": (too few points)"

        Dim n As Integer = 0
        Dim mean As Double = 0
        Dim m2 As Double = 0
        Dim lo As Double = Double.MaxValue
        Dim hi As Double = Double.MinValue

        For i As Integer = first To last
            Dim y As Double = data(i).Y
            n += 1
            Dim delta As Double = y - mean
            mean += delta / n
            m2 += delta * (y - mean)
            If y < lo Then lo = y
            If y > hi Then hi = y
        Next

        Dim stdev As Double = Math.Sqrt(m2 / (n - 1))
        Dim drift As Double = data(last).Y - data(first).Y
        Dim driftPpm As String = If(mean <> 0, (drift / Math.Abs(mean) * 1000000).ToString("0.00") & " ppm", "")

        Return name & ": mean " & mean.ToString("0.########") & "   STDEV " & stdev.ToString("0.########") &
               vbLf & "     min " & lo.ToString("0.########") & "   max " & hi.ToString("0.########") &
               "   p-p " & (hi - lo).ToString("0.########") &
               vbLf & "     drift " & drift.ToString("0.########") & " (" & driftPpm & ")"

    End Function

    ' Recomputes the region text when the span, the data or the trace visibility changed (called every render).
    Private Sub Chart2UpdateRegionStats()

        If Chart2RegionSpan Is Nothing OrElse Not Chart2RegionSpan.IsVisible Then Exit Sub

        Dim x1 As Double = Chart2RegionSpan.Left
        Dim x2 As Double = Chart2RegionSpan.Right

        Dim key As String = String.Join("|", {x1.ToString("R"), x2.ToString("R"), Chart2Dev1Data.Count.ToString(), Chart2Dev2Data.Count.ToString(),
                                              Chart2Dev1Series.IsVisible.ToString(), Chart2Dev2Series.IsVisible.ToString()})
        If key = Chart2RegionKey Then Exit Sub
        Chart2RegionKey = key

        Dim lines As New List(Of String)
        Dim sampleCount As Integer = Math.Max(Chart2Dev1Data.Count, Chart2Dev2Data.Count)
        Dim minsPerSample As Double = If(sampleCount > 1 AndAlso Chart2TotalMins > 0, Chart2TotalMins / (sampleCount - 1), 0)

        Dim regionFirst As Integer = Math.Max(0, CInt(Math.Ceiling(x1)))
        Dim regionLast As Integer = CInt(Math.Floor(x2))
        Dim header As String = "REGION  " & regionFirst.ToString() & " - " & regionLast.ToString() & "  (" & (regionLast - regionFirst + 1).ToString() & " samples"
        If minsPerSample > 0 Then header &= ", " & ((regionLast - regionFirst) * minsPerSample).ToString("0.0") & " mins"
        lines.Add(header & ")")

        For Each item In {Tuple.Create("Dev 1", Chart2Dev1Data, Chart2Dev1Series), Tuple.Create("Dev 2", Chart2Dev2Data, Chart2Dev2Series)}
            If Not item.Item3.IsVisible OrElse item.Item2.Count = 0 Then Continue For
            Dim first As Integer = Math.Max(0, CInt(Math.Ceiling(x1)))
            Dim last As Integer = Math.Min(item.Item2.Count - 1, CInt(Math.Floor(x2)))
            lines.Add(Chart2RegionLine(item.Item1, item.Item2, first, last))
        Next

        Chart2RegionText.LabelText = String.Join(vbLf, lines)

    End Sub

